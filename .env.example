DATABASE_URL=postgresql+psycopg://帳號:密碼@localhost:5432/資料庫名稱

# 資料庫連線字串（必填）
DATABASE_URL=postgresql+psycopg://帳號:密碼@localhost:5432/資料庫名稱

# JWT 簽名密鑰（必填）：請換成至少 32 字元的隨機字串，產生方式見下方
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=請換成你自己產生的隨機字串

# JWT 加密演算法（選填，預設 HS256）
ALGORITHM=HS256
